# DeepSeek API Key
# Получите ключ на https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Модель DeepSeek (доступные: deepseek-chat, deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat

# Telegram Bot Token
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Allowed User ID (для ограничения доступа)
# Укажите ваш Telegram ID, чтобы только вы могли использовать бота
# Узнать свой ID: напишите @userinfobot в Telegram
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# GigaChat API Credentials
# Получите на https://developers.sber.ru/
# Нужен для семантического (векторного) поиска
# Формат: base64(client_id:client_secret)
GIGACHAT_CLIENT_CREDENTIALS=your_gigachat_client_credentials_here

# Brave Search API Key
# Получите на https://brave.com/search/api/
# Бесплатный тариф: 2000 запросов/месяц
BRAVE_API_KEY=your_brave_api_key_here
